#include <Arduino.h>
#include <SHA256.h> // Include standard crypto library or use mbedtls built into ESP core

// Define a non-initialized memory section so the bootloader doesn't wipe it
#define PUF_SIZE 64 // Number of bytes to read from uninitialized RAM

// For ESP8266 / ESP32 non-init memory allocation attribute
#if defined(ESP8266)
  uint8_t sram_puf_buffer[PUF_SIZE] __attribute__((section(".noinit")));
#elif defined(ESP32)
  RTC_DATA_ATTR uint8_t sram_puf_buffer[PUF_SIZE]; // Using RTC slow/fast memory as uninitialized persistent space on reboot
#else
  uint8_t sram_puf_buffer[PUF_SIZE];
#endif

SHA256 sha256;

void generatePUFKey() {
  Serial.println("\n[INFO] Reading uninitialized SRAM physical states...");

  // Print the raw physical startup bytes
  Serial.print("Raw SRAM Fingerprint (Hex): ");
  for (int i = 0; i < PUF_SIZE; i++) {
    if (sram_puf_buffer[i] < 0x10) Serial.print("0");
    Serial.print(sram_puf_buffer[i], HEX);
  }
  Serial.println();

  // Hash the raw physical RAM state to generate a clean 256-bit Cryptographic Key
  uint8_t hashResult[32];
  sha256.reset();
  sha256.update(sram_puf_buffer, PUF_SIZE);
  sha256.finalize(hashResult, sizeof(hashResult));

  // Print the final derived cryptographic key
  Serial.print("Derived Crypto Key (SHA-256): 0x");
  for (int i = 0; i < 32; i++) {
    if (hashResult[i] < 0x10) Serial.print("0");
    Serial.print(hashResult[i], HEX);
  }
  Serial.println("\n---------------------------------------------------");
}

void setup() {
  Serial.begin(115200);
  delay(1000); // Allow serial monitor to stabilize

  Serial.println("\n=== HARDWARE SECURITY NODE INITIALIZED ===");
  generatePUFKey();
  
  Serial.println("Instructions: Press the physical RST (Reset) button on your board.");
  Serial.println("Notice how the Derived Crypto Key remains identical, proving physical silicon binding.");
}

void loop() {
  // Do nothing in loop. The device acts as a secure cryptographic node on boot.
}
